---
import { Picture } from 'astro:assets';
const { image, alt, index, total } = Astro.props;

// Resolve image from src/assets — paths come in as "/img/..."
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/**/*.{png,jpg,jpeg,webp,avif,gif}'
);
const imageKey = `/src/assets${image}`;
const imageImport = allImages[imageKey];
const resolvedImage = imageImport ? (await imageImport()).default : null;
---
<section class="overflow-hidden w-full">
  <button
    type="button"
    class="group relative block w-full cursor-zoom-in"
    aria-label={index && total ? `Enlarge image ${index} of ${total}: ${alt}` : `Enlarge image: ${alt}`}
  >
  {resolvedImage
    ? <Picture
        src={resolvedImage}
        formats={['avif']}
        fallbackFormat="webp"
        alt={alt}
        class="w-full h-auto"
        widths={[600, 900, 1200, 1800]}
        sizes="(min-width: 1280px) 1200px, 100vw"
        loading="lazy"
        decoding="async"
        data-lightbox
      />
    : <img
        src={image}
        loading="lazy"
        decoding="async"
        alt={alt}
        class="w-full h-auto"
        data-lightbox
      />
  }
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-4 top-4 z-10 inline-flex items-center gap-2 rounded-full bg-charcoal/75 px-3 py-2 text-[0.65rem] uppercase tracking-[0.14em] text-white/90 opacity-0 shadow-sm transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
    >
      <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6m-1.5-4.5L14 10m-5 11H3v-6m1.5 4.5L10 14" />
      </svg>
      <span>View larger</span>
    </span>
  </button>
</section>
