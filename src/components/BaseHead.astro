---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { getImage } from 'astro:assets';
import cormorantGaramond300 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';

export interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: unknown;
	noindex?: boolean;
}

const { title, description, image, schema, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://katevoet.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
// Resolve a "/img/..." image prop to an optimized built asset for the social
// card; anything else passes through; default is the generic site card.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/**/*.{png,jpg,jpeg,webp,avif,gif}'
);
let ogImage = new URL('/social.jpg', siteUrl);
let ogImageWidth = 1200;
let ogImageHeight = 630;
let ogImageType = 'image/jpeg';
if (image) {
  const imageImport = allImages[`/src/assets${image}`];
  if (imageImport) {
    const optimized = await getImage({ src: (await imageImport()).default, width: 1200, format: 'jpeg' });
    ogImage = new URL(optimized.src, siteUrl);
    ogImageWidth = Number(optimized.attributes.width ?? optimized.options.width ?? 1200);
    ogImageHeight = Number(optimized.attributes.height ?? optimized.options.height ?? 630);
    ogImageType = `image/${optimized.options.format ?? 'jpeg'}`;
  } else {
    ogImage = new URL(image, siteUrl);
  }
}

function replaceSchemaImage(value: unknown): unknown {
  if (value === image && image) return ogImage.href;
  if (Array.isArray(value)) return value.map(replaceSchemaImage);
  if (value && typeof value === 'object') {
    return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, replaceSchemaImage(entry)]));
  }
  return value;
}

const pageSchema = schema ? replaceSchemaImage(schema) : null;
const pageType = Astro.url.pathname === '/about/'
  ? 'profile'
  : Astro.url.pathname.startsWith('/projects/')
    ? 'video.movie'
    : 'website';
// Only project pages carry a film still as the social card; for every other
// page (default card, about portrait, 404) the bare title is the right alt.
const ogImageAlt = pageType === 'video.movie' && image ? `${title} — film still` : title;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kate Voet',
  '@id': 'https://katevoet.com/#kate-voet',
  jobTitle: ['Film Director', 'Screenwriter'],
  url: new URL('/about/', siteUrl).href,
  email: 'hi@katevoet.com',
  nationality: 'Belgian',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brussels',
    addressCountry: 'Belgium',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Amsterdam' },
    { '@type': 'CollegeOrUniversity', name: 'LUCA School of Arts' },
    { '@type': 'CollegeOrUniversity', name: 'The New School' },
  ],
  knowsAbout: ['Film direction', 'Screenwriting', 'Interactive VR film'],
  award: [
    'Venice Immersive Achievement Prize',
    'Best XR Film at Clermont-Ferrand',
    'Agog Immersive Impact Award at SXSW',
  ],
  description: 'Belgian film director and screenwriter based in Brussels. Award-winning VR film A Long Goodbye premiered at Venice Film Festival 2025.',
  sameAs: [
    'https://www.instagram.com/_katevoet/',
    'https://www.linkedin.com/in/kate-voet-78a448383/',
    'https://hennemanagency.nl/talent/kate-voet/',
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#1a1a1a" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Canonical (404 responses are noindex and have no canonical target) -->
{!noindex && <link rel="canonical" href={canonicalUrl} />}

<!-- Above-the-fold fonts are self-hosted via @fontsource. -->
<link rel="preload" as="font" type="font/woff2" crossorigin href={cormorantGaramond300} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={montserrat400} />
<script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
{!noindex && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Kate Voet" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{!noindex && <meta name="twitter:url" content={canonicalUrl} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- JSON-LD: Person schema -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
{pageSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />}
