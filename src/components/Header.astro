---
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="px-8 md:px-16 lg:px-24 py-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="group">
      <span id="nav-logo" class="text-subtitle text-charcoal group-hover:opacity-70 transition-colors duration-500 tracking-[0.2em]">
        Kate Voet
      </span>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-10">
      <a href="/" id="nav-work" class="text-subtitle text-charcoal/70 hover:opacity-100 transition-colors duration-500 link-underline">
        Work
      </a>
      <a href="/about/" id="nav-about" class="text-subtitle text-charcoal/70 hover:opacity-100 transition-colors duration-500 link-underline">
        About
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden p-2 -m-2 text-charcoal/80 hover:text-charcoal transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-charcoal/95 backdrop-blur-sm">
    <div class="px-8 py-8 flex flex-col gap-6">
      <a href="/" class="py-2 text-subtitle text-white/70 hover:text-white transition-colors">Work</a>
      <a href="/about/" class="py-2 text-subtitle text-white/70 hover:text-white transition-colors">About</a>
    </div>
  </div>
</header>

<script>
  // Colour helpers re-query the DOM so they target the current header after
  // Astro view-transition navigations.
  function setNavColour(overHero: boolean) {
    const header = document.getElementById('site-header');
    const logo = document.getElementById('nav-logo');
    const navWork = document.getElementById('nav-work');
    const navAbout = document.getElementById('nav-about');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    if (!header || !logo || !navWork || !navAbout || !mobileBtn) return;
    const lightClasses = ['text-white', 'text-white/70', 'text-white/80'];
    const darkClasses = ['text-charcoal', 'text-charcoal/70', 'text-charcoal/80'];
    const from = overHero ? darkClasses : lightClasses;
    const to = overHero ? lightClasses : darkClasses;
    [logo, navWork, navAbout, mobileBtn].forEach((element, index) => {
      element.classList.replace(from[index === 0 ? 0 : index === 3 ? 2 : 1], to[index === 0 ? 0 : index === 3 ? 2 : 1]);
    });
    header.classList.toggle('bg-cream/85', !overHero);
    header.classList.toggle('backdrop-blur-sm', !overHero);
  }

  function updateActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll('nav a, #mobile-menu a').forEach((link) => {
      const href = link.getAttribute('href');
      const active = href === '/' ? path === '/' : path.startsWith(href || '');
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
      link.classList.toggle('active-nav', active);
    });
  }

  function updateNav() {
    const hero = document.querySelector('[data-hero]');
    const headerHeight = document.getElementById('site-header')?.offsetHeight || 72;
    const overHero = hero ? hero.getBoundingClientRect().bottom > headerHeight : false;
    setNavColour(overHero);
    updateActiveNav();
  }

  // Per-page setup: apply the colour state and close any menu left open by the
  // previous page. The delegated toggle listener below is bound only once.
  function closeMobileMenu() {
    document.getElementById('mobile-menu')?.classList.add('hidden');
    const btn = document.getElementById('mobile-menu-btn');
    if (!btn) return;
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open menu');
  }

  function initNav() {
    updateNav();
    closeMobileMenu();
  }

  // Delegation keeps one listener alive across Astro view-transition swaps.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const btn = target?.closest('#mobile-menu-btn');
    if (!btn) return;
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    const hidden = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!hidden));
    btn.setAttribute('aria-label', hidden ? 'Open menu' : 'Close menu');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menu = document.getElementById('mobile-menu');
    const btn = document.getElementById('mobile-menu-btn');
    if (!menu || !btn || menu.classList.contains('hidden')) return;
    closeMobileMenu();
    btn.focus();
  });

  // Scroll listener bound ONCE — window persists across view transitions, so
  // binding it per page-load would accumulate handlers (one extra per nav).
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => { updateNav(); ticking = false; });
    }
  }, { passive: true });

  // Same rAF/ticking pattern — keeps the header colour in sync when the
  // viewport changes size mid-hero (window resize, device rotation).
  window.addEventListener('resize', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        updateNav();
        // The menu is hidden by `md:hidden` above the breakpoint, so its
        // button state has to be reset or it keeps announcing "Close menu".
        if (window.matchMedia('(min-width: 768px)').matches) closeMobileMenu();
        ticking = false;
      });
    }
  }, { passive: true });

  document.addEventListener('visibilitychange', () => {
    ticking = false;
    if (!document.hidden) updateNav();
  });

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
