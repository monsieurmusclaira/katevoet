---
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="px-8 md:px-16 lg:px-24 py-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="group">
      <span id="nav-logo" class="text-subtitle text-white group-hover:opacity-70 transition-colors duration-500 tracking-[0.2em]">
        Kate Voet
      </span>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-10">
      <a href="/" id="nav-work" class="text-subtitle text-white/70 hover:opacity-100 transition-colors duration-500 link-underline">
        Work
      </a>
      <a href="/about/" id="nav-about" class="text-subtitle text-white/70 hover:opacity-100 transition-colors duration-500 link-underline">
        About
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden text-white/80 hover:text-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-charcoal/95 backdrop-blur-sm">
    <div class="px-8 py-8 flex flex-col gap-6">
      <a href="/" class="text-subtitle text-white/70 hover:text-white transition-colors">Work</a>
      <a href="/about/" class="text-subtitle text-white/70 hover:text-white transition-colors">About</a>
    </div>
  </div>
</header>

<script>
  // Colour helpers re-query the DOM each call so they target the current
  // (re-rendered) header after Astro view-transition navigations.
  function setNavColour(light: boolean) {
    const logo = document.getElementById('nav-logo');
    const navWork = document.getElementById('nav-work');
    const navAbout = document.getElementById('nav-about');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    if (!logo || !navWork || !navAbout || !mobileBtn) return;
    if (light) {
      logo.classList.replace('text-charcoal', 'text-white');
      navWork.classList.replace('text-charcoal/70', 'text-white/70');
      navAbout.classList.replace('text-charcoal/70', 'text-white/70');
      mobileBtn.classList.replace('text-charcoal/80', 'text-white/80');
    } else {
      logo.classList.replace('text-white', 'text-charcoal');
      navWork.classList.replace('text-white/70', 'text-charcoal/70');
      navAbout.classList.replace('text-white/70', 'text-charcoal/70');
      mobileBtn.classList.replace('text-white/80', 'text-charcoal/80');
    }
  }

  function updateNav() {
    setNavColour(!(window.scrollY > window.innerHeight * 0.8));
  }

  // Per-page setup: apply the colour state and close any menu left open by the
  // previous page. The delegated toggle listener below is bound only once.
  function initNav() {
    updateNav();
    document.getElementById('mobile-menu')?.classList.add('hidden');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', 'false');
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-label', 'Open menu');
  }

  // Delegation keeps one listener alive across Astro view-transition swaps.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const btn = target?.closest('#mobile-menu-btn');
    if (!btn) return;
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    const hidden = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!hidden));
    btn.setAttribute('aria-label', hidden ? 'Open menu' : 'Close menu');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menu = document.getElementById('mobile-menu');
    const btn = document.getElementById('mobile-menu-btn');
    if (!menu || !btn || menu.classList.contains('hidden')) return;
    menu.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open menu');
  });

  // Scroll listener bound ONCE — window persists across view transitions, so
  // binding it per page-load would accumulate handlers (one extra per nav).
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { updateNav(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
