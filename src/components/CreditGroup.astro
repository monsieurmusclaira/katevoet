---
// One role and its people, billing-block style: a quiet tracked caption over
// names set in the display face. `lead` bumps the scale for Director/Cast.
const { role, names = [], lead = false } = Astro.props;
const nameList = Array.isArray(names) ? names : [names];
---
<div class="min-w-0">
  <p class="text-caption text-warmgray mb-3">{role}</p>
  <ul
    class:list={[
      'text-charcoal',
      lead ? 'text-3xl md:text-4xl leading-tight' : 'text-xl md:text-2xl leading-snug',
    ]}
  >
    {/* The display face goes on the <li>: global.css styles `li` by element,
        which beats a family inherited from the list. */}
    {nameList.map((name) => <li class="font-cormorant font-light break-words">{name}</li>)}
  </ul>
</div>
