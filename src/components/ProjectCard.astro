---
import { Picture } from 'astro:assets';
const { title, img, year, genre, url, featured = false } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/**/*.{png,jpg,jpeg,webp,avif,gif}'
);
const imageKey = `/src/assets${img}`;
const imageImport = allImages[imageKey];
const resolvedImage = imageImport ? (await imageImport()).default : null;
---
<a
  href={url}
  class:list={[
    'group block relative overflow-hidden bg-charcoal',
    // Sources are 16:9 film stills — portrait crops discarded most of the
    // frame and upscaled. These ratios stay close to native, so the browser
    // never scales past the source. Ratios step up by breakpoint (never two at
    // the same one, which would race in the cascade); the taller 4/3 on small
    // phones keeps the caption block from clipping. A min-height would instead
    // make aspect-ratio derive width from height and overflow the column.
    featured ? 'aspect-[4/3] sm:aspect-[3/2] md:col-span-2 md:aspect-[21/9]' : 'aspect-[4/3] sm:aspect-[3/2]',
  ]}
>
  {/* Image */}
  <div class="absolute inset-0 img-hover-zoom">
    {resolvedImage
      ? <Picture
          src={resolvedImage}
          formats={['avif']}
          fallbackFormat="webp"
          alt=""
          class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-105 group-hover:opacity-90"
          widths={featured ? [800, 1200, 1600, 1920] : [500, 800, 1100, 1600]}
          sizes={featured
            ? '(min-width: 1472px) 1280px, (min-width: 1024px) calc(100vw - 192px), (min-width: 768px) calc(100vw - 128px), calc(100vw - 64px)'
            : '(min-width: 1472px) 624px, (min-width: 1024px) calc((100vw - 224px) / 2), (min-width: 768px) calc((100vw - 160px) / 2), calc(100vw - 64px)'}
          quality={80}
          loading="lazy"
          decoding="async"
        />
      : <img
          src={img}
          alt=""
          class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-105 group-hover:opacity-90"
          loading="lazy"
          decoding="async"
        />
    }
  </div>

  {/* Default Overlay */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent opacity-100 transition-opacity duration-500"></div>

  {/* Content */}
  <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
    <div class="transform transition-transform duration-500 ease-out group-hover:-translate-y-2">
      <p class="text-caption text-[#c8a97e] mb-2">{year} — {genre}</p>
      <h3 class="text-2xl md:text-3xl text-white font-light leading-tight">
        {title}
      </h3>
    </div>
    {/* Persistent CTA - always visible */}
    <div class="mt-4 flex items-center gap-2 text-white/80 group-hover:text-white transition-colors duration-300">
      <span class="text-subtitle text-xs tracking-widest">View Project</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
      </svg>
    </div>
  </div>

  {/* Hover Overlay */}
  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
</a>
