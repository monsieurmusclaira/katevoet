---
const { heading, eyebrow, festivalname } = Astro.props;
---
{heading &&
  <div class="col-span-full mb-4">
    {eyebrow && <p class="text-caption text-warmgray mb-2">{eyebrow}</p>}
    <h2 class="text-2xl md:text-3xl text-charcoal">{heading}</h2>
  </div>
}
<div class="col-span-full grid grid-cols-1 md:grid-cols-[minmax(0,10rem)_1fr] gap-x-6 gap-y-1">
  <p class="md:col-start-2 font-bold">{festivalname}</p>
</div>