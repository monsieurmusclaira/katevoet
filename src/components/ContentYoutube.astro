---
const { YoutubeLink } = Astro.props;
import { YouTube } from '@astro-community/astro-embed-youtube';
---

<section class="p-5 flex flex-col items-center" data-aos="fade-up" data-aos-duration="600">
    <h2 class="text-secondary p-5" style="font-size: clamp(1.2rem, 2.5vw, 1.6rem);">Trailer</h2>
    <YouTube id={YoutubeLink} />
</section>