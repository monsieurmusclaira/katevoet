---
const today = new Date();
---

<footer class="bg-charcoal text-white/60 py-16 px-8 md:px-16 lg:px-24">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:flex-wrap justify-between items-start md:items-center gap-x-8 gap-y-8">
    <div>
      <p class="text-subtitle text-white/70 mb-2">Kate Voet</p>
      <p class="text-caption text-white/60">Director & Screenwriter</p>
    </div>

    <div class="flex flex-col md:flex-row md:flex-wrap md:items-center gap-4 md:gap-x-6 md:gap-y-2">
      <a href="/" class="py-2 text-subtitle text-white/50 hover:text-white transition-colors duration-300 link-underline">
        Work
      </a>
      <a href="/about/" class="py-2 text-subtitle text-white/50 hover:text-white transition-colors duration-300 link-underline">
        About
      </a>
      <a href="mailto:hi@katevoet.com" class="py-2 text-body text-white/70 hover:text-white transition-colors duration-300 link-underline">
        hi@katevoet.com
      </a>
      <a href="https://www.instagram.com/_katevoet/" target="_blank" rel="noopener noreferrer" class="py-2 text-subtitle text-white/50 hover:text-white transition-colors duration-300 link-underline">
        Instagram
      </a>
      <a href="https://www.linkedin.com/in/kate-voet-78a448383/" target="_blank" rel="noopener noreferrer" class="py-2 text-subtitle text-white/50 hover:text-white transition-colors duration-300 link-underline">
        LinkedIn
      </a>
    </div>

    <p class="text-caption text-white/60">
      &copy; <span id="footer-year">{today.getFullYear()}</span>
    </p>
  </div>
</footer>

<!-- Static builds freeze the year at build time; refresh it in the browser. -->
<script is:inline data-astro-rerun>
  var fy = document.getElementById('footer-year');
  if (fy) fy.textContent = new Date().getFullYear();
</script>
