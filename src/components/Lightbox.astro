---
---

{/* Lightbox Overlay */}
<div id="lightbox-overlay" transition:persist class="fixed inset-0 z-[100] bg-charcoal/95 opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center px-4 py-6" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" aria-describedby="lightbox-description" aria-hidden="true" inert>
  <h2 id="lightbox-title" class="sr-only">Image viewer</h2>
  <p id="lightbox-description" class="sr-only">Use the left and right arrow keys to browse images, or press Escape to close.</p>
  <p id="lightbox-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
  
  {/* Close button */}
  <button id="lightbox-close" class="absolute top-6 right-6 text-white/60 hover:text-white transition-colors duration-300 z-10 p-2" aria-label="Close">
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  {/* Prev button */}
  <button id="lightbox-prev" disabled class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-white/90 hover:text-white transition-all duration-300 z-10 p-4 rounded-full bg-charcoal/60 backdrop-blur-sm disabled:cursor-not-allowed" aria-label="Previous image" aria-disabled="true">
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 md:h-12 md:w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </button>

  {/* Next button */}
  <button id="lightbox-next" disabled class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-white/90 hover:text-white transition-all duration-300 z-10 p-4 rounded-full bg-charcoal/60 backdrop-blur-sm disabled:cursor-not-allowed" aria-label="Next image" aria-disabled="true">
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 md:h-12 md:w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </button>

  {/* Image container */}
  <div class="relative flex max-h-[90vh] max-w-[90vw] flex-col items-center justify-center gap-3">
    <div class="relative flex min-h-0 max-h-[calc(85vh-5rem)] max-w-[90vw] items-center justify-center">
      <img id="lightbox-image" src="" alt="" class="max-h-[calc(85vh-5rem)] max-w-full object-contain shadow-2xl" />
    </div>

    {/* Caption / Counter */}
    <div class="min-h-[2.5rem] max-w-[80vw] text-center">
      <p id="lightbox-caption" class="text-caption break-words text-white/60"></p>
      <p id="lightbox-counter" class="mt-1 text-caption text-white/60"></p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const overlay = document.getElementById('lightbox-overlay');
    const img = document.getElementById('lightbox-image');
    const caption = document.getElementById('lightbox-caption');
    const counter = document.getElementById('lightbox-counter');
    const title = document.getElementById('lightbox-title');
    const description = document.getElementById('lightbox-description');
    const status = document.getElementById('lightbox-status');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    
    let images = [];
    let currentIndex = 0;
    let isOpen = false;
    let touchStartX = 0;
    let touchEndX = 0;
    let lastFocused = null;
    let previousBodyOverflow = null;

    // Refresh the images array and button state (safe to call repeatedly)
    function init() {
      currentIndex = 0;
      images = Array.from(document.querySelectorAll('img[data-lightbox]'));
      updateButtons();
    }

    // Single delegated click listener — never accumulates
    document.addEventListener('click', (e) => {
      const target = e.target.closest('button[aria-label^="Enlarge image"]');
      const img = target?.querySelector('img[data-lightbox]') || e.target.closest('img[data-lightbox]');
      if (!img) return;
      e.preventDefault();
      const index = images.indexOf(img);
      if (index !== -1) open(index);
    });

    function open(index) {
      if (images.length === 0 || !images[index]) return;
      lastFocused = document.activeElement;
      if (!isOpen) previousBodyOverflow = document.body.style.overflow;
      currentIndex = index;
      isOpen = true;
      updateImage();
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      overlay.setAttribute('aria-hidden', 'false');
      overlay.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
      updateButtons();
      closeBtn.focus();
    }

    function close(restoreFocus = true) {
      isOpen = false;
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('inert', '');
      if (previousBodyOverflow !== null) {
        document.body.style.overflow = previousBodyOverflow;
        previousBodyOverflow = null;
      }
      if (restoreFocus && lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      lastFocused = null;
    }

    function updateImage() {
      const currentImg = images[currentIndex];
      if (!currentImg) { close(false); return; }
      img.src = currentImg.currentSrc || currentImg.src;
      img.alt = currentImg.alt || '';
      caption.textContent = currentImg.alt || '';
      counter.textContent = `${currentIndex + 1} / ${images.length}`;
      title.textContent = currentImg.alt || 'Image viewer';
      description.textContent = `Image ${currentIndex + 1} of ${images.length}. Use the left and right arrow keys to browse images, or press Escape to close.`;
      status.textContent = `${currentImg.alt ? `${currentImg.alt}. ` : ''}Image ${currentIndex + 1} of ${images.length}.`;
    }

    function prev() {
      if (currentIndex > 0) {
        currentIndex--;
        updateImage();
        updateButtons();
      }
    }

    function next() {
      if (currentIndex < images.length - 1) {
        currentIndex++;
        updateImage();
        updateButtons();
      }
    }

    function updateButtons() {
      const atStart = currentIndex === 0;
      const atEnd = currentIndex === images.length - 1;
      const previousDisabled = atStart || images.length === 0;
      const nextDisabled = atEnd || images.length === 0;
      prevBtn.disabled = previousDisabled;
      nextBtn.disabled = nextDisabled;
      prevBtn.classList.toggle('opacity-30', previousDisabled);
      prevBtn.setAttribute('aria-disabled', String(previousDisabled));
      nextBtn.classList.toggle('opacity-30', nextDisabled);
      nextBtn.setAttribute('aria-disabled', String(nextDisabled));
    }

    // The overlay persists across view transitions, so it must be dismissed
    // before the swap — otherwise it strands over the next page, still showing
    // the previous gallery's image, with the body scroll lock silently lost.
    document.addEventListener('astro:before-swap', () => { if (isOpen) close(false); });

    // Event listeners
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prev(); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); next(); });
    
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay || e.target.closest('.relative') === null) {
        close();
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      switch(e.key) {
        case 'Escape':
          close();
          break;
        case 'ArrowLeft':
          prev();
          break;
        case 'ArrowRight':
          next();
          break;
        case 'Tab': {
          // Trap focus within the dialog's controls.
          const focusable = [closeBtn, prevBtn, nextBtn].filter((button) => !button.disabled);
          const idx = focusable.indexOf(document.activeElement);
          e.preventDefault();
          const dir = e.shiftKey ? -1 : 1;
          const nextIdx = (idx === -1 ? 0 : (idx + dir + focusable.length) % focusable.length);
          focusable[nextIdx].focus();
          break;
        }
      }
    });

    // Touch / swipe support
    overlay.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    overlay.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          next();
        } else {
          prev();
        }
      }
    }

    // Initialize on every page load (including Astro view transitions)
    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') {
      init();
    }
  })();
</script>
